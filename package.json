{
  "name": "local-knowledge-graph",
  "version": "1.9.0",
  "description": "本地知识图谱整合器：3D可视化 + AI对话建图 + 智能检索 + Git回溯 + RDF合规，全流程本地运行",
  "main": "server.js",
  "bin": {
    "kg": "bin/cli.js"
  },
  "files": [
    "bin/",
    "lib/",
    "public/",
    "tools/",
    "mcp/",
    ".opencode/",
    "server.js",
    "HELP.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings server.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "express": "^4.22.3",
    "pdf-parse": "^2.4.5"
  },
  "keywords": [
    "knowledge-graph",
    "3d-visualization",
    "rdf",
    "local-first",
    "opencode",
    "sqlite"
  ],
  "author": "iamsamyiok",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamsamyiok/local-knowledge-graph.git"
  }
